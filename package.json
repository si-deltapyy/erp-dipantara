{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint resources/js/src && node scripts/check-frontend.mjs",
        "format:check": "prettier --check resources/js/src scripts/check-frontend.mjs vite.config.js eslint.config.js tailwind.frontend.config.js tsconfig.json .prettierrc.json package.json",
        "format": "prettier --write resources/js/src scripts/check-frontend.mjs vite.config.js eslint.config.js tailwind.frontend.config.js tsconfig.json .prettierrc.json package.json",
        "postinstall": "patch-package"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/forms": "^0.5.2",
        "@types/node": "^22.20.4",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/test-utils": "^2.5.1",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.6.1",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.0",
        "jsdom": "^26.1.0",
        "laravel-vite-plugin": "^2.0.0",
        "patch-package": "^8.0.1",
        "postcss": "^8.5.28",
        "prettier": "^3.9.8",
        "sass": "^1.105.1",
        "tailwindcss": "^3.4.19",
        "typescript": "~5.9",
        "typescript-eslint": "^8.70.0",
        "vite": "^7.0.7",
        "vitest": "^4.1.11",
        "vue-tsc": "^3.3.11"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.7.1",
        "html5-qrcode": "^2.3.8",
        "nice-select2": "2.6.0",
        "pinia": "^3.0.4",
        "vue": "^3.5.43",
        "vue-i18n": "^11.4.12",
        "vue-router": "^4.6.4"
    }
}
